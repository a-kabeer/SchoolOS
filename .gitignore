# ==============================================================================
# SchoolOS Repository .gitignore
# Targets: .NET 10 / C#, React / TypeScript / Vite, Node.js, Docker, IDEs & OS
# ==============================================================================

# ------------------------------------------------------------------------------
# Build and Compilation Artifacts (.NET / C#)
# ------------------------------------------------------------------------------
bin/
obj/
[Bb]in/
[Oo]bj/
out/
publish/
Generated_Code/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.pidb
*.booproj

# Build logs & crash reports
*.log
*.binlog
*.tlog
TestResult*
[Tt]est[Rr]esults/
[Bb]uild[Ll]og.*

# ------------------------------------------------------------------------------
# Node.js, Frontend & Package Managers (React + TypeScript / Vite)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite and frontend build outputs
frontend/**/dist/
frontend/**/dist-ssr/
frontend/**/.vite/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL: Never commit secrets)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
appsettings.Development.json
appsettings.*.local.json

# License private keys and certificates
*.pfx
*.p12
*.pem
*.key
*.cer
*.crt
!deploy/certs/README.md

# ------------------------------------------------------------------------------
# IDEs and Editors
# ------------------------------------------------------------------------------
# Visual Studio
.vs/
*.dotCover

# JetBrains (Rider, WebStorm)
.idea/
*.sln.iml

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------------------------------------------
# Databases, Backups & Ephemeral Runtime
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
*.bak
*.dump
*.sql.gz
local_db_data/
postgres_data/

# ------------------------------------------------------------------------------
# OS-Specific Files
# ------------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
