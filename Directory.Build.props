<Project>
  <PropertyGroup>
    <!-- Target framework aligned with Blueprint v1.7 (.NET 10 LTS target) -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Common Company Metadata -->
  <PropertyGroup>
    <Company>SchoolOS</Company>
    <Product>SchoolOS Educational Management Platform</Product>
    <Copyright>Copyright © 2026 SchoolOS</Copyright>
  </PropertyGroup>
</Project>
