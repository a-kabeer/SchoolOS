# SchoolOS Local Development Environment Configuration
# Copy this file to deploy/.env and supply strong local/dev passwords.
# NEVER commit real production passwords or keys to source control.

ASPNETCORE_ENVIRONMENT=Development
POSTGRES_USER=schoolos_dev
POSTGRES_PASSWORD=change-me-local-pg-pass
POSTGRES_DB=schoolos_local_dev
POSTGRES_PORT=5432

# Least-privilege non-owner runtime DB role (NOSUPERUSER NOBYPASSRLS)
RUNTIME_DB_ROLE=schoolos_app
RUNTIME_DB_PASSWORD=change-me-runtime-role-pass

# Automatic migrations on startup (set false in managed production pipelines)
BOOTSTRAP_AUTO_MIGRATE=true
BOOTSTRAP_SEED_CATALOG=true

# Development-only Initial Admin Seeder (blocked automatically in Production)
DEV_BOOTSTRAP_ENABLED=true
DEV_ADMIN_EMAIL=admin@schoolos.local
DEV_ADMIN_PASSWORD=ChangeMe#LocalDev2026!
