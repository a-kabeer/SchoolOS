FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY Directory.Build.props Directory.Packages.props SchoolOS.sln ./
COPY src/ ./src/

RUN dotnet restore src/Hosts/SchoolOS.Cloud.Api/SchoolOS.Cloud.Api.csproj
RUN dotnet publish src/Hosts/SchoolOS.Cloud.Api/SchoolOS.Cloud.Api.csproj \
    -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish ./

ENV ASPNETCORE_URLS=http://+:8081
EXPOSE 8081
USER $APP_UID

ENTRYPOINT ["dotnet", "SchoolOS.Cloud.Api.dll"]
